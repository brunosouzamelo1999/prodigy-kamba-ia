{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "README.md",
      "AGENTS.md",
      "kamba-chat-ia.code-workspace"
    ],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": "chat"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local.env",
        ".env.*.local"
      ]
    }
  ]
}
