rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras de segurança para usuários do Meu Kota IA
    match /users/{userId} {
      // Cada usuário só pode ler e escrever os seus próprios dados de perfil e limites
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcoleção de conversas do usuário
      match /chats/{chatId} {
        // Cada usuário tem acesso exclusivo aos seus próprios chats e mensagens
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bloquear qualquer outro acesso não autorizado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
